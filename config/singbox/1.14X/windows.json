    {"tag": "TikTok", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "Netflix", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "Wallet", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "Steam", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "Microsoft", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto", "Direct"]},
    {"tag": "OneDrive", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto", "Direct"]},
    {"tag": "Apple", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto", "Direct"]},
    {"tag": "VPS", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto", "Direct"]},
    {"tag": "Nomatch", "type": "selector", "outbounds": ["Default", "JP",  "HK", "US", "Selector", "Auto", "Direct"]},
    {"tag": "JP", "type": "selector", "outbounds": ["Auto-JP"]},
    {"tag": "HK", "type": "selector", "outbounds": ["Auto-HK"]},
    {"tag": "US", "type": "selector", "outbounds": ["Auto-US"]},
    {"tag": "Selector", "type": "selector", "outbounds": []},
    {"tag": "Auto", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "30m", "tolerance": 100},
    {"tag": "Auto-JP", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "30m", "tolerance": 100},
    {"tag": "Auto-HK", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "30m", "tolerance": 100},
    {"tag": "Auto-US", "type": "urltest", "outbounds": [], "url": "https://clients1.google.com/generate_204", "interval": "30m", "tolerance": 100},
    {"tag": "Latency", "type": "urltest", "outbounds": ["Direct"], "url": "http://connect.rom.miui.com/generate_204", "interval": "30m"},
    {"tag": "GLOBAL", "type": "selector", "outbounds": ["Default", "AI", "YouTube", "Google", "Github", "Telegram", "TikTok", "Netflix", "Wallet", "Steam", "Microsoft", "OneDrive", "Apple", "Nomatch", "JP",  "HK", "US", "Selector", "Auto", "Latency", "Direct"]},
    {"tag": "Direct", "type": "direct", "domain_resolver": "dnspod"},
    {"tag": "Bridge","type": "bridge"}
  ],
  "http_clients": [
    {"tag": "Direct_Download", "detour": "Direct"}
  ],
  "route": {
    "rules": [
      {"type": "logical", "mode": "and", "rules": [{"port": [53, 853], "invert": true}, {"clash_mode": "Global", "invert": true}, {"preferred_by": ["Bridge"]}, {"type": "logical", "mode": "or", "rules": [{"ip_is_private": true}, {"rule_set": "geoip-cn"}]}], "outbound": "Bridge"},
      {"type": "logical", "mode": "or", "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "geoip-telegram"}], "invert": true, "action": "sniff", "sniffer": ["http", "tls", "stun", "quic", "dns"], "timeout": "100ms"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {"ip_is_private": true, "outbound": "Direct"},
      {"type": "logical", "mode": "or", "rules": [{"port": 853}, {"protocol": ["stun", "quic"]}], "action": "reject", "no_drop": true},
      {"network": "icmp", "action": "resolve"},
      {"network": "icmp", "outbound": "Direct"},
      {"clash_mode": "Direct", "outbound": "Direct"},
      {"clash_mode": "Global", "outbound": "GLOBAL"},
      {"rule_set": "geosite-private", "outbound": "Direct"},
      {"rule_set": "geosite-category-ai-!cn", "outbound": "AI"},
      {"rule_set": "geosite-youtube", "outbound": "YouTube"},
      {"rule_set": "geosite-google", "outbound": "Google"},
      {"rule_set": "geosite-github", "outbound": "Github"},
      {"rule_set": "geosite-onedrive", "outbound": "OneDrive"},
