{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {"tag": "local", "type": "local", "prefer_go": true},
      {"tag": "ali", "type": "https", "server": "223.5.5.5"},
      {"tag": "dnspod", "type": "https", "server": "doh.pub", "domain_resolver": "hosts"},
      {"tag": "google", "type": "https", "server": "8.8.8.8", "detour": "Auto"},
      {"tag": "cf", "type": "https", "server": "1.1.1.1", "detour": "Default"},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"},
      {"type": "hosts", "tag": "hosts", "predefined": {"doh.pub": ["1.12.12.21", "120.53.53.53"]}}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"clash_mode": "Direct", "server": "dnspod"},
      {"clash_mode": "Global", "server": "fakeip"},
      {"rule_set": ["fakeipfilter-cn", "geosite-cn", "geosite-microsoft@cn", "geosite-apple@cn", "geosite-private"], "server": "dnspod"},
      {"rule_set": "fakeipfilter-!cn", "server": "cf"},
      {"type": "logical", "mode": "and", "rules": [{"query_type": ["A", "AAAA"]}, {"rule_set": "geosite-geolocation-!cn", "invert": true}], "action": "evaluate", "server": "google", "client_subnet": "223.5.5.0/24","timeout": "2s"},
      {"match_response": true, "rule_set": "geoip-cn", "server": "dnspod"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "cf",
    "strategy": "prefer_ipv4",
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
  "outbounds": [
    {"tag": "Default", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "AI", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
    {"tag": "YouTube", "type": "selector", "outbounds": ["JP",  "HK", "US", "Selector", "Auto"]},
